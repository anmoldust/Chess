# Configuration that must NOT be committed with real values.
#
# Copy to `.env` beside this file (docker compose reads it automatically) and fill in.
# `.env` is gitignored. The defaults baked into the services are for local development only.

# The credential that lets the gateway mint tokens on a user's behalf.
# Rotate it per environment; treat it as a secret.
CCMMD_INTERNAL_TOKEN=change-me-per-environment

# Optional: point engine-service at a UCI engine. The image already bakes in Stockfish 19,
# so this is only needed to use a different binary or a different build.
# CCMMD_ENGINE_BINARY=stockfish

# Optional: the point at which an account is temporarily locked out of sign-in.
# CCMMD_LOGIN_MAX_ATTEMPTS=5
# CCMMD_LOGIN_WINDOW=PT5M

# --- Not yet configurable, and required before this is production-ready ---
# Postgres credentials live in infra/postgres/init.sql with dev defaults (postgres/postgres and
# *_svc/*_svc). TLS terminates nowhere: nginx serves plain HTTP. The JWT signing key is generated
# on first boot and written to the auth-service container's filesystem, with no rotation.

# Java / Maven — every module, not just backend/
**/target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/public/stockfish/
npm-debug.log*
# Vite writes a transpiled config snapshot here on some Windows setups; it embeds absolute paths.
frontend/vite.config.ts.timestamp-*

# Env / secrets
.env
.env.local
*.local
# Production deploy state — secrets, TLS material, backups and the rollback marker.
deploy/.env.production
deploy/.last-good-tag
deploy/secrets/
deploy/backups/

# IDE
.idea/
.vscode/
*.iml
.DS_Store

# OS
Thumbs.db

# dev tooling output
infra/tools/stub-capture.log

# Command Code's own CLI state — personal machine state, not project source
.commandcode/settings.json

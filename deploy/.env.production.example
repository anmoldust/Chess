# =============================================================================
# CCMMD production environment — copy to deploy/.env.production and fill in.
#
#   cp deploy/.env.production.example deploy/.env.production
#   chmod 600 deploy/.env.production
#
# docker compose reads this via --env-file, and it is the ONLY place secrets live on
# the VPS. Never commit it (already git-ignored via `.env*`). Keep a copy in a vault.
# =============================================================================

# --- Image source ---------------------------------------------------------------------------
# Owner must be lowercase (GHCR requirement). TAG is the git SHA CI deploys.
GHCR_OWNER=your-github-username
TAG=latest

# --- Public hostname (used by the deploy health check and the reset link) --------------------
DOMAIN=ccmmd.example.com

# --- Postgres -------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-superuser

AUTH_DB_PASSWORD=change-me-auth
GAME_DB_PASSWORD=change-me-game
MATCHMAKING_DB_PASSWORD=change-me-matchmaking
NOTIFICATION_DB_PASSWORD=change-me-notification
ANALYSIS_DB_PASSWORD=change-me-analysis

# --- RabbitMQ -------------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=chess
RABBITMQ_DEFAULT_PASS=change-me-rabbit
RABBITMQ_ERLANG_COOKIE=change-me-erlang-cookie

# --- Redis (sessions + presence) ------------------------------------------------------------
REDIS_PASSWORD=change-me-redis

# --- Application secrets --------------------------------------------------------------------
# The credential that lets the gateway mint tokens on a user's behalf. Rotate per environment.
CCMMD_INTERNAL_TOKEN=change-me-internal-token
# Force Secure cookies. MUST be true in production (TLS terminates at Cloudflare).
CCMMD_COOKIE_SECURE=true
CCMMD_COOKIE_SAME_SITE=Lax

# --- Password-reset email -------------------------------------------------------------------
# Point at any SMTP relay (a provider like Resend/SES/Postmark, or your own). Unset => links are
# only logged, which is not acceptable in production.
CCMMD_RESET_BASE_URL=https://ccmmd.example.com/#/reset
CCMMD_RESET_MAIL_FROM=no-reply@ccmmd.example.com
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=apikey
SPRING_MAIL_PASSWORD=change-me-smtp

# --- Off-site backups (Cloudflare R2 or any S3-compatible store) -----------------------------
# Used by deploy/scripts/backup-db.sh via rclone (remote name: r2). Leave unset to keep local only.
R2_ACCOUNT_ID=change-me
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_BUCKET=ccmmd-backups
